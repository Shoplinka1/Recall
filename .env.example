# Recall runtime
APP_ENV=development
APP_URL=http://localhost:5173
VITE_API_BASE_URL=
DEMO_MODE=true

# The current demo workflow does not require a database at startup.
# Set DATABASE_URL before enabling persisted production routes.
DATABASE_URL=
SESSION_SECRET=

# AI stays cost-free in development mode.
AI_MODE=development
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Paystack billing is optional in development.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_PRO_ANNUAL_PLAN_CODE=
# Required for server-side verification; set the exact Paystack plan amounts in NGN.
PAYSTACK_PRO_MONTHLY_AMOUNT_NGN=
PAYSTACK_PRO_ANNUAL_AMOUNT_NGN=

# Optional transactional email provider.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=